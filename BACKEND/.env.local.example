# Copia questo file in .env.local e compilalo. .env.local non va committato.
# Su Render gli stessi valori si inseriscono dalla dashboard (sono 'sync: false' in render.yaml).

# Chiave di firma JWT, almeno 32 byte. Generane una con:  openssl rand -base64 48
JWT_SECRET=

# Amministratore iniziale: creato al primo avvio se ADMIN_PASSWORD è valorizzata
# e non esiste già un ADMIN. Impostala con ./set-admin-password.sh
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@unchained.local
ADMIN_PASSWORD=

# Origine del frontend ammessa dal CORS
ALLOWED_ORIGIN=http://localhost:5173

# Invio mail. Le chiavi restano COMMENTATE finché non le compili con ./set-mail-credentials.sh:
# una variabile definita ma vuota NON attiva il valore di ripiego di application.properties
# (${MAIL_FROM:...} vale solo se la variabile non esiste) e fa fallire l'avvio su @NotBlank.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_FROM=

# URL pubblico del backend: compone il link di disiscrizione dentro la mail
APP_BASE_URL=http://localhost:8080
